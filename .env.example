# URL do projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica do Supabase, segura para uso no navegador.
# Project Settings > API > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legado: alias antigo da chave publica (anon). Use apenas se o projeto
# ainda nao tiver uma publishable key disponivel.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: chave secreta (service role) para rotinas administrativas no
# servidor. Nunca exponha no cliente nem versione este valor.
# SUPABASE_SERVICE_ROLE_KEY=

# URL publica da aplicacao (usada em links de e-mail, PIX e compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
